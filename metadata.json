{
  "name": "freepenguins-influxdb",
  "version": "2.0.0",
  "author": "freepenguins",
  "summary": "Installs and configures InfluxDB 1.x, its databases, users and retention policies",
  "license": "Apache-2.0",
  "source": "https://github.com/freepenguins/puppet-influxdb",
  "project_page": "https://github.com/freepenguins/puppet-influxdb",
  "issues_url": "https://github.com/freepenguins/puppet-influxdb/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    },
    {
      "name": "puppetlabs/apt",
      "version_requirement": ">= 9.2.0 < 12.0.0"
    },
    {
      "name": "puppet/systemd",
      "version_requirement": ">= 4.0.0 < 10.0.0"
    },
    {
      "name": "puppet/healthcheck",
      "version_requirement": ">= 1.0.0 < 3.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "11",
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04"
      ]
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9"
      ]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": [
        "8",
        "9"
      ]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": [
        "8",
        "9"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 7.0.0 < 9.0.0"
    }
  ],
  "tags": [
    "influxdb",
    "influxdata",
    "tsdb",
    "timeseries",
    "metrics"
  ],
  "pdk-version": "3.4.0",
  "template-url": "https://github.com/puppetlabs/pdk-templates#3.8.0",
  "template-ref": "tags/3.8.0-0-gf1124a6"
}
